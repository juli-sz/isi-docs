# Estado local de Obsidian (cambia todo el tiempo y ensucia el historial)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache
**/.obsidian/plugins/*/data.json

# Papelera de Obsidian
.trash/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Notas privadas (también están en los ignorePatterns de Quartz)
private/
privado/

# Por si alguna vez se instala algo en la raíz
node_modules/
